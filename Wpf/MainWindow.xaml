<Window x:Class="MultiTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MultiTool" Width="1140" Height="760" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <!-- Собственный заголовок: системный убран, верхние 40 px окна — область перетаскивания -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═════ Боковая панель ═════ -->
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,18,14,14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,26">
                        <Border Width="38" Height="38" CornerRadius="11">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C8CFF" Offset="0"/>
                                    <GradientStop Color="#9B6DFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE765;" Style="{StaticResource IconText}" FontSize="19"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MultiTool" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Автоматизация ввода" Style="{StaticResource Muted}" FontSize="11.5"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- состояние горячих клавиш -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,12" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource SuccessBrush}"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock x:Name="StatusTitle" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBlock x:Name="StatusSub" Style="{StaticResource Muted}" FontSize="11.5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <RadioButton x:Name="NavHotkeys" Style="{StaticResource NavItem}" Tag="&#xE765;" Content="Горячие клавиши"
                                     GroupName="nav" Checked="OnNavChecked" IsChecked="True"/>
                        <RadioButton x:Name="NavCompare" Style="{StaticResource NavItem}" Tag="&#xE8AB;" Content="Сравнение текстов"
                                     GroupName="nav" Checked="OnNavChecked"/>
                        <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="Инструменты"
                                     GroupName="nav" Checked="OnNavChecked"/>
                        <RadioButton x:Name="NavFiles" Style="{StaticResource NavItem}" Tag="&#xE8A5;" Content="Файлы"
                                     GroupName="nav" Checked="OnNavChecked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Настройки"
                                     GroupName="nav" Checked="OnNavChecked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═════ Содержимое ═════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="32,26,32,18">
                    <TextBlock x:Name="PageTitle" Style="{StaticResource PageHeading}"/>
                    <TextBlock x:Name="PageSubtitle" Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13"/>
                </StackPanel>

                <ContentControl x:Name="Host" Grid.Row="1" Margin="32,0,32,0" IsTabStop="False"/>
            </Grid>

            <!-- ═════ Кнопки окна ═════ -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                        ToolTip="Свернуть" Click="OnMinimize"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        ToolTip="Развернуть" Click="OnMaximizeRestore"/>
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                        ToolTip="Закрыть" Click="OnClose"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
