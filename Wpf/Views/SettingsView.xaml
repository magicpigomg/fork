<UserControl x:Class="MultiTool.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Stack" Margin="0,0,6,20"/>
        </ScrollViewer>

        <!-- панель сохранения -->
        <Border Grid.Row="1" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="0,14,0,16">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="OnSave"/>
                <Button DockPanel.Dock="Left" Content="Открыть папку настроек" Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0" Click="OnOpenFolder"/>
                <Button DockPanel.Dock="Right" Content="Сбросить к умолчанию" Style="{StaticResource DangerButton}" Click="OnReset"/>
                <TextBlock x:Name="SaveStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
