<UserControl x:Class="MultiTool.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,0,24">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="InputRow" Height="170"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ввод -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Текст слева (например, страница сайта)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="LeftBox" Grid.Row="1" Style="{StaticResource MonoTextBox}" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     TextChanged="OnInputChanged"/>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Текст справа (например, платёжное поручение)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="RightBox" Grid.Row="1" Style="{StaticResource MonoTextBox}" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     TextChanged="OnInputChanged"/>
        </Grid>

        <!-- панель действий -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0" LastChildFill="False">
            <Button Content="Сравнить" Style="{StaticResource PrimaryButton}" Click="OnCompare" DockPanel.Dock="Left"/>
            <Button Content="Поменять местами" Click="OnSwap" Margin="8,0,0,0" DockPanel.Dock="Left"/>
            <Button Content="Очистить" Style="{StaticResource GhostButton}" Click="OnClear" Margin="8,0,0,0" DockPanel.Dock="Left"/>
            <CheckBox x:Name="IgnoreCase" Content="Не учитывать регистр" Style="{StaticResource SwitchStyle}"
                      Margin="20,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource MatchBgBrush}"/>
                <TextBlock Text="совпадает" Style="{StaticResource Muted}" Margin="6,0,14,0"/>
                <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource MismatchBgBrush}"/>
                <TextBlock Text="отличается" Style="{StaticResource Muted}" Margin="6,0,14,0"/>
                <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource ExtraBgBrush}"/>
                <TextBlock Text="лишнее" Style="{StaticResource Muted}" Margin="6,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- выбор значений платежа: две кнопки + переключатель вида -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="ExtractSiteButton" Content="Выбрать значения из сайта (слева)" Click="OnExtractSite"
                    DockPanel.Dock="Left"/>
            <Button x:Name="ExtractDocButton" Content="Выбрать значения из документа (справа)" Click="OnExtractDoc"
                    Margin="8,0,0,0" DockPanel.Dock="Left"/>

            <Border DockPanel.Dock="Right" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ModeText" Content="Весь текст" Style="{StaticResource SegmentButton}"
                                 GroupName="compareMode" IsChecked="True" Checked="OnModeChanged"/>
                    <RadioButton x:Name="ModeFields" Content="Поля платежа" Style="{StaticResource SegmentButton}"
                                 GroupName="compareMode" Checked="OnModeChanged"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- макрос .mac из полей платежа (виден в режиме «Поля платежа») -->
        <DockPanel x:Name="MacroBar" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0" LastChildFill="False"
                   Visibility="Collapsed">
            <CheckBox x:Name="MacroSwitch" Content="Создавать файл .mac" Style="{StaticResource SwitchStyle}"
                      VerticalAlignment="Center" DockPanel.Dock="Left"
                      Checked="OnMacroSwitchChanged" Unchecked="OnMacroSwitchChanged"/>
            <Button x:Name="MacroButton" Content="Создать .mac" Style="{StaticResource PrimaryButton}"
                    Margin="16,0,0,0" DockPanel.Dock="Left" Visibility="Collapsed" Click="OnCreateMacro"/>
            <TextBlock x:Name="MacroStatus" Style="{StaticResource Muted}" VerticalAlignment="Center"
                       Margin="14,0,0,0" DockPanel.Dock="Left"/>
        </DockPanel>

        <!-- итог -->
        <Border x:Name="SummaryBorder" Grid.Row="4" Grid.ColumnSpan="3" Margin="0,14,0,14" Padding="16,12"
                CornerRadius="10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <TextBlock x:Name="SummaryText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="Вставьте тексты слева и справа — сравнение выполняется автоматически"
                       Foreground="{StaticResource MutedBrush}"/>
        </Border>

        <!-- результат: либо сравнение всего текста, либо таблица полей платежа -->
        <Grid Grid.Row="5" Grid.ColumnSpan="3">
            <Grid x:Name="TextResultsPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Слева" Style="{StaticResource FieldLabel}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LeftResult" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                       TextWrapping="Wrap" LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Справа" Style="{StaticResource FieldLabel}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="RightResult" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                       TextWrapping="Wrap" LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Отличия" Style="{StaticResource FieldLabel}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="DetailsText" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="19"
                                       LineStackingStrategy="BlockLineHeight"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <Border x:Name="FieldsPanel" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="FieldsGrid" Margin="18,10,18,14"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
