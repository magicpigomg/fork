<Window x:Class="MultiTool.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" IsHitTestVisible="False">
    <Border Margin="16" Padding="16,12" CornerRadius="12" MinWidth="240" MaxWidth="460"
            Background="#EE1B1F29" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="Dot" Width="10" Height="10" Margin="0,5,12,0" VerticalAlignment="Top"
                     Fill="{StaticResource AccentBrush}"/>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="SourceText" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="MessageText" FontSize="13.5" Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
