<UserControl x:Class="MultiTool.Views.HotkeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MultiTool.Models">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,28">

            <!-- главный переключатель -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Глобальные горячие клавиши" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="StateText" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="MasterSwitch" Style="{StaticResource SwitchStyle}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnMasterChanged" Unchecked="OnMasterChanged"/>
                </Grid>
            </Border>

            <TextBlock Text="Сценарии" Style="{StaticResource SectionTitle}" Margin="2,26,0,12"/>

            <ItemsControl x:Name="Cards" Margin="0,0,-14,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Height="132" Margin="0,0,14,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Chip}">
                                        <TextBlock Text="{Binding Key}" FontFamily="{StaticResource MonoFont}"
                                                   FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource Muted}"
                                           Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- последнее значение -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Последнее значение по F1" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="LastValueText" FontFamily="{StaticResource MonoFont}" FontSize="22"
                                   FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                    <Button x:Name="CopyLast" Grid.Column="1" Content="Копировать" Click="OnCopyLast" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- журнал -->
            <Grid Margin="2,26,0,12">
                <TextBlock Text="Журнал" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                <Button Content="Очистить" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                        Padding="10,5" Click="OnClearLog"/>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="6">
                <Grid>
                    <TextBlock x:Name="EmptyLog" Text="Здесь появятся результаты сценариев" Style="{StaticResource Muted}"
                               HorizontalAlignment="Center" Margin="0,22"/>
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Log">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:LogEntry}">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="Auto" MinWidth="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Success">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Grid.Column="1" Text="{Binding Time, StringFormat=HH:mm:ss}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Source}" FontWeight="SemiBold"
                                                   Margin="0,0,16,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
